{
  "name": "paidwithtab",
  "version": "0.3.0",
  "description": "Give your agents spending power. tab prices any HTTP API in a JSON spec and gets it paid per request over HTTP 402, spending capped by signed mandates, settled in USDC on Robinhood Chain. Zero runtime dependencies.",
  "type": "module",
  "bin": { "tab": "bin/tab.js" },
  "files": [
    "bin",
    "dist/src",
    "web",
    "docs",
    "SPEC.md",
    "DEPLOY.md"
  ],
  "scripts": {
    "cli": "node --no-warnings=ExperimentalWarning --import tsx src/cli.ts",
    "build": "tsc",
    "test": "node --no-warnings=ExperimentalWarning --import tsx test/e2e.ts",
    "test:adversarial": "node --no-warnings=ExperimentalWarning --import tsx test/adversarial.ts",
    "test:evm": "node --no-warnings=ExperimentalWarning --import tsx test/evm.ts",
    "upstream": "node --no-warnings=ExperimentalWarning --import tsx examples/upstream.ts",
    "demo": "bash examples/demo.sh",
    "prepublishOnly": "tsc && node --no-warnings=ExperimentalWarning --import tsx test/e2e.ts"
  },
  "repository": { "type": "git", "url": "git+https://github.com/paidwithtab/tab.git" },
  "homepage": "https://github.com/paidwithtab/tab#readme",
  "bugs": { "url": "https://github.com/paidwithtab/tab/issues" },
  "keywords": [
    "agents",
    "payments",
    "http-402",
    "mandates",
    "usdc",
    "robinhood-chain",
    "api-monetization",
    "mcp",
    "claude"
  ],
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
