{
  "realm": "quotes.local",
  "recipient": "${SELLER}",
  "public_receipts": true,
  "services": [
    {
      "name": "demo",
      "prefix": "",
      "upstream": "http://127.0.0.1:4101",
      "description": "Demo API: quotes, echo, and a route that always fails",
      "routes": [
        { "method": "GET",  "path": "/quote", "price": "0.01",  "description": "A random programming quote" },
        { "method": "POST", "path": "/echo",  "price": "0.005", "description": "Echo the request body back" },
        { "method": "GET",  "path": "/boom",  "price": "0.01",  "description": "Always fails upstream; you are never charged" },
        { "method": "GET",  "path": "/free",  "price": "0",     "description": "Free, forwarded unpaid" }
      ]
    },
    {
      "name": "premium",
      "prefix": "/premium",
      "upstream": "http://127.0.0.1:4101",
      "upstream_headers": { "X-Api-Key": "${PREMIUM_KEY}" },
      "description": "Premium routes behind an API key the gateway injects",
      "routes": [
        { "method": "GET",  "path": "/secret",    "price": "0.02", "description": "Requires the injected API key" },
        { "method": "POST", "path": "/translate", "price": "0.01", "description": "SHOUTING-case translation" }
      ]
    }
  ]
}
