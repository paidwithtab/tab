# User-level systemd unit for the token gateway at token.paidwithtab.com (evm rail, the project token on Robinhood Chain mainnet): the same routes as mainnet.paidwithtab.com, priced in the token. Fill in currency, token and decimals in examples/spec-token.json first.
# Install: cp examples/tab-gateway-token.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now tab-gateway-token
[Unit]
Description=tab token gateway (token.paidwithtab.com, evm rail, the project token on Robinhood Chain mainnet)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/tab
EnvironmentFile=-%h/tab/.env
ExecStart=/usr/bin/node --no-warnings=ExperimentalWarning %h/tab/dist/src/cli.js serve --spec %h/tab/examples/spec-token.json --db %h/tab/token.db --port 1407 --announce http://127.0.0.1:1403 --origin https://token.paidwithtab.com
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
