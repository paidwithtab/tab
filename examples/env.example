# Provider API keys for the paid routes in examples/spec-public.json (and the testnet and mainnet specs).
# Copy to ~/tab/.env (mode 600). A service whose key is empty is skipped at start, not listed broken.
# The gateway units read this file through EnvironmentFile; restart them after a change.
TAVILY_API_KEY=
DEEPL_API_KEY=
DEEPGRAM_API_KEY=
